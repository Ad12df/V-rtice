# Puerto del servidor
PORT=3000

# Host (0.0.0.0 recomendado para Docker y Render)
HOST=0.0.0.0

# Entorno (development | production | test)
NODE_ENV=development

# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Nomenclatura tradicional de Supabase:
SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# O Nomenclatura nueva (opcional si ya definiste ANON y SERVICE_ROLE):
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_key_aqui
# SUPABASE_SECRET_KEY=sb_secret_tu_key_aqui
